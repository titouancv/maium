  "privacyPolicy": {
    "title": "Privacy policy",
    "backButton": "Back",
    "lastUpdated": "Last updated: May 23, 2025",
    "intro": "maium (\"we\", \"our\", \"us\") is committed to protecting your privacy. This policy explains what data we collect, why we collect it, and how we use it.",
    "section1Title": "1. Data we collect",
    "section1Body": "When you create an account and use maium, we collect: your email address, first and last name, username, date of birth, phone number (optional), nationality, location, professional and educational experiences, social network links, hobbies, skills, and projects. We also collect authentication data via Google and Apple OAuth.",
    "section2Title": "2. How we use your data",
    "section2Body": "Your data is used to create and display your public profile, authenticate you securely, provide app features (search, recommendations), and improve the service. We do not sell your personal data to third parties.",
    "section3Title": "3. Data sharing",
    "section3Body": "Your profile information (name, username, experiences, hobbies, skills, projects, and links) is visible to other maium users. Sensitive data such as your email address, phone number, date of birth, and nationality are never shown publicly.",
    "section4Title": "4. Data retention",
    "section4Body": "Your data is retained as long as your account is active. When you delete your account, all your personal data is permanently deleted from our systems within 30 days.",
    "section5Title": "5. Your rights",
    "section5Body": "You have the right to access, correct, or delete your personal data at any time from the Settings page. For any other requests, contact us at titouancv@icloud.com.",
    "section6Title": "6. Cookies",
    "section6Body": "We use strictly necessary cookies for authentication and session management. No advertising or tracking cookies are used.",
    "section7Title": "7. Contact",
    "section7Body": "For any questions about this privacy policy, please contact us at titouancv@icloud.com."
  }
